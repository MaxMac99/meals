      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschen"
          }
        }
      }
    },
    "Delete '%@'? It comes off the plan and its ingredients come off the shopping list. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' löschen? Es kommt aus dem Plan und seine Zutaten von der Einkaufsliste. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "Delete '%@'? Its saved aisle order goes with it and the list goes back to the default order." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' löschen? Seine gespeicherte Gang-Reihenfolge verschwindet, und die Liste kehrt zur Standard-Reihenfolge zurück."
          }
        }
      }
    },
    "Delete '%@'? Its saved aisle order goes with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' löschen? Seine gespeicherte Gang-Reihenfolge verschwindet."
          }
        }
      }
    },
    "Delete '%@'? Only works if nothing references it — recipes, meals and list lines all protect their ingredients." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' löschen? Klappt nur, wenn nichts darauf verweist — Rezepte, Mahlzeiten und Listzeilen schützen ihre Zutaten."
          }
        }
      }
    },
    "Delete '%@'? Recipes stay in the library; cooked history stays on the record. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' löschen? Rezepte bleiben in der Bibliothek; die Koch-Historie bleibt erhalten. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
