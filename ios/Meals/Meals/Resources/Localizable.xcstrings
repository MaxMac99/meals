      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abmelden"
          }
        }
      }
    },
    "Loose ingredients go straight on the shopping list with the meal — no recipe needed. Tap one to change its amount." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lose Zutaten landen direkt mit der Mahlzeit auf der Einkaufsliste — ohne Rezept. Tippe darauf, um die Menge zu ändern."
          }
        }
      }
    },
