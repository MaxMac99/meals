          }
        }
      }
    },
    "Starts a plan for you if there isn't one yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet bei Bedarf automatisch einen Plan."
          }
        }
      }
    },
    "sticks aren't metric — use g or ml" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticks sind nicht metrisch — nimm g oder ml"
          }
        }
      }
    },
    "Stored under a name a new recipe wouldn't use, with nothing to merge into. Filing one moves it to the modern name, keeping its aisle, staple flag and verdict." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert unter einem Namen, den neue Rezepte nicht verwenden würden — ohne Partner zum Zusammenführen. Beim Ablegen wandert sie zum modernen Namen und behält Gang, Vorrats-Flag und Preisurteil."
          }
        }
      }
    },
    "suggested" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschlag"
          }
        }
      }
    },
    "Supermarkets" : {
