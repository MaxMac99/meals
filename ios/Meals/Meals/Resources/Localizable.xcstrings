{
  "sourceLanguage" : "en",
  "strings" : {
    " They enter it when creating their account, along with this server's address." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Beim Registrieren geben sie ihn zusammen mit der Adresse dieses Servers ein."
          }
        }
      }
    },
    "'%@' already exists as '%@'. Merge '%@' into it? It keeps its own aisle, staple flag and verdict. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' existiert bereits als '%@'. '%@' hinein zusammenführen? Es behält Gang, Vorrats-Flag und Preisurteil. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "'%@' is filed under '%@' — that's already this ingredient." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' liegt unter '%@' — das ist bereits diese Zutat."
          }
        }
      }
    },
    "'%@' still uses this recipe. Remove it from that meal first, then delete the recipe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' nutzt dieses Rezept noch. Entferne es erst aus dieser Mahlzeit, dann lösche das Rezept."
          }
        }
      }
    },
