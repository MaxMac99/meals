            "value" : "Verlassen"
          }
        }
      }
    },
    "Leave the amount blank for things you don't measure. Metric (g, ml) or a count of a natural unit — 2 tins, 3 cloves." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Menge bei Dingen weg, die du nicht misst. Metrisch (g, ml) oder eine Stückzahl natürlicher Einheit — 2 Dosen, 3 Zehen."
          }
        }
      }
    },
    "Leave this household? You keep your account and your tokens, and land in an empty household of your own. The recipes, plan and history stay here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Haushalt verlassen? Dein Konto und deine Tokens bleiben, und du landest in einem eigenen, leeren Haushalt. Rezepte, Plan und Historie bleiben hier."
          }
        }
      }
    },
    "Log in" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmelden"
          }
        }
      }
    },
    "Log out" : {
