            "value" : "Plan starten"
          }
        }
      }
    },
    "Start a pool of meal options for the week — no days, no schedule." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege einen Vorrat an Mahlzeiten für die Woche an — ohne Tage, ohne Terminplan."
          }
        }
      }
    },
    "Start from" : {
      "extractionState" : "manual",
